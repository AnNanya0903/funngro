# ---------------------------------------------------------------------------
# Environment variables for the Funngro website.
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Canonical base URL of the deployed site. Used for sitemap, canonical tags,
# and Open Graph. Set this to your real deployment URL (e.g. on Vercel).
NEXT_PUBLIC_SITE_URL=https://funngro.com

# ---------------------------------------------------------------------------
# Contact form email provider.
# Choose ONE of the following. The API route (/api/contact) sends the email.
# ---------------------------------------------------------------------------

# Option A - Resend (recommended for "API route that sends email"):
#   Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM=Funngro <hello@funngro.com>

# Option B - Formspree (no key needed, posts forwarded by Resend-free service):
#   Set to your Formspree form endpoint, e.g. https://formspree.io/f/XXXXXXXX
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
